<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>BigDaddy</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>vip.bigdaddy.monitor</string>
  <key>CFBundleName</key>
  <string>BigDaddy</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.4</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>BigDaddy</string>
  <!-- 纯后台守护进程，没有可见窗口；不加这个开关的话 App Nap 会在系统判定"不活跃"
       时降低/延迟本 App 的 Timer 触发频率和网络请求节奏，导致心跳/命令轮询在孩子
       没有操作电脑时变得断断续续。 -->
  <key>NSAppSleepDisabled</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>BigDaddy needs to read the address of the current browser tab so a parent can accurately view browsing activity.</string>
  <key>BigDaddyAPIBaseURL</key>
  <string>http://localhost:8009/api/v1</string>
  <key>BigDaddyDashboardBaseURL</key>
  <string>http://localhost:4000</string>
  <key>SUFeedURL</key>
  <string>https://beautare.github.io/big-daddy-macOS/appcast.xml</string>
  <key>SUPublicEDKey</key>
  <string>+LI1alzpb3qC3FratMxA0qd+C4cDw4ElhV0NPh1U/+4=</string>
  <!-- 4 小时检查一次。Sparkle 对这个值有 1 小时的硬性下限
       （SPUUpdaterSettings.minimumUpdateCheckInterval），写得比 3600 小也会被抬回去。 -->
  <key>SUScheduledCheckInterval</key>
  <integer>14400</integer>
  <!-- 显式声明这两项，跳过 Sparkle 首次运行时"是否自动检查更新"的系统询问对话框：
       后台按 SUScheduledCheckInterval 无条件检查并静默下载。

       SUAutomaticallyUpdate=true 决定了 Sparkle 走 SPUAutomaticUpdateDriver 而不是
       SPUScheduledUpdateDriver——前者的 showingUpdate 恒为 NO、全程不碰 user driver，
       下载完就把安装权交给安装器进程"等 App 退出时再装"，默认对用户零提示。
       "问用户要不要现在装并重启"这一步因此不能挂在 user driver 上，由 AppDelegate 的
       SPUUpdaterDelegate 接管，见 updater(_:willInstallUpdateOnQuit:immediateInstallationBlock:)。 -->
  <key>SUEnableAutomaticChecks</key>
  <true/>
  <key>SUAutomaticallyUpdate</key>
  <true/>
</dict>
</plist>
